{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "apple-base",
      "hidden": true,
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ipad",
      "inherits": "apple-base",
      "binaryDir": "${sourceDir}/_build_ipad",
      "cacheVariables": { "CMAKE_SYSTEM_NAME": "iOS", "CMAKE_OSX_SYSROOT": "iphoneos" }
    },
    {
      "name": "ipad-simulator",
      "inherits": "ipad",
      "binaryDir": "${sourceDir}/_build_ipad_simulator",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "iphonesimulator", "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO" }
    },
    {
      "name": "appletv",
      "inherits": "apple-base",
      "binaryDir": "${sourceDir}/_build_appletv",
      "cacheVariables": { "CMAKE_SYSTEM_NAME": "tvOS", "CMAKE_OSX_SYSROOT": "appletvos" }
    },
    {
      "name": "appletv-simulator",
      "inherits": "appletv",
      "binaryDir": "${sourceDir}/_build_appletv_simulator",
      "cacheVariables": { "CMAKE_OSX_SYSROOT": "appletvsimulator", "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO" }
    }
  ],
  "buildPresets": [
    { "name": "ipad", "configurePreset": "ipad", "configuration": "Release", "targets": ["EmptyEpsilon"] },
    { "name": "ipad-simulator", "configurePreset": "ipad-simulator", "configuration": "Release", "targets": ["EmptyEpsilon"] },
    { "name": "appletv", "configurePreset": "appletv", "configuration": "Release", "targets": ["EmptyEpsilon"] },
    { "name": "appletv-simulator", "configurePreset": "appletv-simulator", "configuration": "Release", "targets": ["EmptyEpsilon"] }
  ]
}
